load "iovtk"
load "gmsh"
string meshfile="/home/saltyroboticist/Desktop/FEM/Basic Exec and learn/1DC_COMP_CIRCDOM.edp/mesh.msh"; 
mesh mesh2=gmshload(meshfile);
int size=90; 
mesh Mesh;
int r1=5; 
int r2=7; 
int r3=9; 
border c1(t=0, 2*pi){x=r1*cos(t); y=r1*sin(t);};
border c2(t=0, 2*pi){x=r2*cos(t); y=r2*sin(t);};
border c3(t=0, 2*pi){x=r3*cos(t); y=r3*sin(t);}; 

Mesh=buildmesh(c1(-size)+c2(size)+c3(size)); 
plot(Mesh, wait=1);
// Dirichlet conditions
int T1=273+100; 
int T2=273+80; 
int T3=273+50; 
//fespace space0(mesh2, P1);
//space0 T, w; 
//solve solv(T,w)
// = int2d(mesh2)((dx(w)*dx(T)*x))
    //+on(8, T=T1)
    //+on(6, T=T2)
    //+on(7, T=T3);

fespace sp1(Mesh, P1); 
sp1 u, W; 
solve solt(u, W)
=int2d(Mesh)((dx(W)*dx(u)*x))
    +on(c1, u=T1)
    +on(c2, u=T2)
    +on(c3, u=T3);
int[int] out=[1];
//savevtk("soln.vtk", mesh2, T, dataname="Temp", order=out); 
savevtk("soln3.vtk", Mesh, u, dataname="Temp", order=out); 
